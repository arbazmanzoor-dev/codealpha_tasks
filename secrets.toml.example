# Copy this file to .streamlit/secrets.toml and fill in your key.
# secrets.toml is git-ignored; never commit a real key.

# Official Google Cloud Translation API key (Google Cloud console →
# APIs & Services → Credentials → Create credentials → API key).
GOOGLE_TRANSLATE_API_KEY = ""

# Optional: force a backend (google_cloud, google_free, mymemory, microsoft).
# By default google_cloud is used whenever the key above is set.
# TRANSLATOR_BACKEND = "google_cloud"
